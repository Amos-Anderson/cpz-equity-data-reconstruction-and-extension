# Alpaca Paper Trading Credentials
# Copy this file to .env and fill in real values. Never commit .env.
# Paper account: create at https://app.alpaca.markets/paper/dashboard/overview

ALPACA_KEY_ID=your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# External data path (already on your machine from CPZ reconstruction)
ML4T_DATA_DIR=C:\Users\amosa\ml4t_data

# WRDS credentials are handled via .pgpass (already configured)
# See: C:\Users\amosa\AppData\Roaming\postgresql\pgpass.conf